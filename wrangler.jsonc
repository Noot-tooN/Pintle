{
  "name": "pintle-p0-local",
  "main": "crates/cloudflare/build/worker/shim.mjs",
  "compatibility_date": "2026-10-24",
  "workers_dev": false,
  "preview_urls": false,
  "build": { "command": "./bin/just build" },
  "durable_objects": {
    "bindings": [{ "name": "AUTHORITIES", "class_name": "PintleAuthority" }]
  },
  "migrations": [{ "tag": "p0-sqlite-v1", "new_sqlite_classes": ["PintleAuthority"] }]
  // P1_ENABLED, P11_ENABLED, and P2_ENABLED are absent.
  // Tests select one mode. P2 rejects mixing with P1/P1.1 regression modes.
  // Protocol tests require ephemeral PINTLE_TEST_CREDENTIALS; no defaults.
  // Future staging: explicit PINTLE_AUTH_MODE=static + PINTLE_CREDENTIALS secret.
  // Optional PINTLE_METRICS=true emits sanitized events. See docs/deployment.md.
}
